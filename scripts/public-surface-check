#!/bin/sh
set -eu

# Keep every public OSS surface — code, docs, examples, and the Makefile
# itself — free of private organization/product names. Public package
# coordinates such as github.com/jim-technologies/temporaless are
# intentionally allowed. The deny-list comes from this repository's own
# review; extend it here whenever a new private name must never appear.
pattern='(^|[^[:alnum:]_])(medallion|jimtech)([^[:alnum:]_]|$)|Connect/Ontology'

surfaces="README.md CHANGELOG.md CONVENTIONS.md AGENTS.md SECURITY.md \
MAKEFILE-CONTRACT.md Makefile docs examples api core adapters cmd scripts"

if command -v rg >/dev/null 2>&1; then
  # shellcheck disable=SC2086 # surfaces is a deliberate word list
  matches="$(
    rg -n -i \
      --glob '!**/dist/**' \
      --glob '!**/node_modules/**' \
      --glob '!**/gen/**' \
      --glob '!**/__pycache__/**' \
      --glob '!**/.venv/**' \
      --glob '!scripts/public-surface-check' \
      "$pattern" \
      $surfaces \
      || true
  )"
else
  # shellcheck disable=SC2086 # surfaces is a deliberate word list
  matches="$(
    grep -RIInEi "$pattern" $surfaces \
      | grep -v '/dist/' \
      | grep -v '/node_modules/' \
      | grep -v '/gen/' \
      | grep -v '__pycache__' \
      | grep -v '/\.venv/' \
      | grep -v '^scripts/public-surface-check:' \
      || true
  )"
fi

if [ -n "$matches" ]; then
  echo "Private/internal references found on public OSS surfaces:" >&2
  echo "$matches" >&2
  echo >&2
  echo "Use generic wording such as application services, consumer services, or services using Temporaless." >&2
  exit 1
fi
