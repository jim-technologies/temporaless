#!/bin/sh
set -eu

buf generate
buf generate --template adapters/py/dagstercompat/buf.gen.yaml
buf generate --template adapters/go/console/buf.gen.yaml

# protoc-gen-connectrpc-py 0.12.1 currently emits trailing spaces on generated
# optional-header parameters. Use Python instead of GNU-only `sed -i` so the
# one-command generator is identical on Linux and macOS Flox environments.
python3 - \
  core/py/src/temporaless/v1/temporaless_connect.py \
  core/py/src/temporaless/v1/inspection_connect.py \
  adapters/py/dagstercompat/tests/gen/compat/v1/workflow_connect.py \
  adapters/py/dagstercompat/tests/server_gen/compat/v1/workflow_connect.py <<'PY'
from pathlib import Path
import sys

for value in sys.argv[1:]:
    path = Path(value)
    lines = path.read_text(encoding="utf-8").splitlines()
    path.write_text("".join(f"{line.rstrip()}\n" for line in lines), encoding="utf-8")
PY

# The TypeScript Invariant projection consumes the application descriptor at
# runtime. Buf's language plugins do not emit a descriptor set, so build it
# explicitly as part of the same generation command.
buf build api --as-file-descriptor-set \
  -o core/ts/src/gen/temporaless/v1/temporaless_descriptor.binpb

# The optional console's Invariant Protocol server reads both contracts' source
# comments at runtime, so it embeds the two descriptor sets it registers.
mkdir -p adapters/go/console/descriptors
buf build api --as-file-descriptor-set \
  -o adapters/go/console/descriptors/temporaless.binpb
buf build third_party/medallion-terminal-core/proto --as-file-descriptor-set \
  -o adapters/go/console/descriptors/terminal.binpb
