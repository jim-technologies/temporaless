#!/bin/sh
set -eu

python3 scripts/check_versions.py
buf lint
buf format --diff --exit-code api
buf lint adapters/py/dagstercompat/tests/proto
buf format --diff --exit-code adapters/py/dagstercompat/tests/proto
buf lint adapters/go/console/proto
buf format --diff --exit-code adapters/go/console/proto
head_commit="$(git rev-parse HEAD)"
release_tag="v$(tr -d '\n' < VERSION)"
baseline_tag=""
for candidate in $(git tag --merged HEAD --list 'v[0-9]*.[0-9]*.[0-9]*' --sort=-version:refname); do
  case "$candidate" in
    *-*) continue ;;
  esac
  # On the release commit, compare against the preceding release rather than
  # against the candidate tag itself. Do not skip an older tag merely because
  # the dirty worktree happens to be based directly on its commit.
  if [ "$candidate" = "$release_tag" ] &&
    [ "$(git rev-list -n 1 "$candidate")" = "$head_commit" ]; then
    continue
  fi
  baseline_tag="$candidate"
  break
done
if [ -n "$baseline_tag" ]; then
  python3 scripts/check_buf_breaking.py \
    --against ".git#tag=$baseline_tag,subdir=api" \
    --baseline-tag "$baseline_tag" \
    --version "$(tr -d '\n' < VERSION)"
else
  echo "Skipping the Buf compatibility check; no prior plain SemVer tag is reachable." >&2
fi
# The Python Connect generator is intentionally installed from the locked core
# development environment because the BSR-hosted plugin lags the 0.11 runtime.
uv sync --project core/py --locked
# Remote BSR plugins need authentication to avoid the strict anonymous rate
# limit, and CI is secretless by policy: every gate — CI included — validates
# the checked-in descriptor and compiles/tests every generated consumer
# instead. Maintainers prove a trusted regeneration is clean locally by
# setting TEMPORALESS_REQUIRE_BUF_GENERATE=1 (which also fails on any
# remote-plugin error) before releasing schema changes.
if [ -n "${BUF_TOKEN:-}" ] || [ "${TEMPORALESS_REQUIRE_BUF_GENERATE:-0}" = "1" ]; then
  scripts/generate
else
  echo "Skipping remote Buf plugin regeneration without BUF_TOKEN; set TEMPORALESS_REQUIRE_BUF_GENERATE=1 to force it." >&2
fi
scripts/public-surface-check
scripts/public-surface-check-test
descriptor_file="$(mktemp)"
trap 'rm -f "$descriptor_file"' EXIT HUP INT TERM
buf build api --as-file-descriptor-set -o "$descriptor_file"
if ! cmp -s "$descriptor_file" core/ts/src/gen/temporaless/v1/temporaless_descriptor.binpb; then
  echo "core/ts/src/gen/temporaless/v1/temporaless_descriptor.binpb is stale; run scripts/generate." >&2
  exit 1
fi
if ! cmp -s "$descriptor_file" adapters/go/console/descriptors/temporaless.binpb; then
  echo "adapters/go/console/descriptors/temporaless.binpb is stale; run scripts/generate." >&2
  exit 1
fi
buf build third_party/medallion-terminal-core/proto --as-file-descriptor-set -o "$descriptor_file"
if ! cmp -s "$descriptor_file" adapters/go/console/descriptors/terminal.binpb; then
  echo "adapters/go/console/descriptors/terminal.binpb is stale; run scripts/generate." >&2
  exit 1
fi
if [ "${CI:-}" = "true" ]; then
  # A clean CI checkout must remain clean after formatting/code generation.
  # Local feature branches may intentionally be validating uncommitted schema
  # changes, so this assertion is CI-only.
  git diff --exit-code -- \
    api \
    core/go/gen \
    adapters/go/console/configv1 \
    adapters/go/console/internal/terminalv1 \
    adapters/go/console/descriptors \
    core/py/src/buf \
    core/py/src/temporaless/v1 \
    core/ts/src/gen \
    adapters/py/dagstercompat/tests/gen \
    adapters/py/dagstercompat/tests/server_gen
  generated_untracked="$(git ls-files --others --exclude-standard -- \
    api \
    core/go/gen \
    adapters/go/console/configv1 \
    adapters/go/console/internal/terminalv1 \
    adapters/go/console/descriptors \
    core/py/src/buf \
    core/py/src/temporaless/v1 \
    core/ts/src/gen \
    adapters/py/dagstercompat/tests/gen \
    adapters/py/dagstercompat/tests/server_gen)"
  if [ -n "$generated_untracked" ]; then
    echo "Buf generation produced untracked files:" >&2
    echo "$generated_untracked" >&2
    exit 1
  fi
fi
if command -v npm >/dev/null 2>&1; then
  # A fresh checkout (CI included) has no node_modules; install the locked
  # dependency tree exactly. An existing local install is left alone.
  if [ ! -d node_modules ]; then
    npm ci
  fi
  npm run check
  # The optional console's UI host type-checks against the pinned dashboard
  # framework and runs its tests (jsdom, a fake console behind the app's
  # fetch). Building it (make build-console) is not part of the gate.
  if [ ! -d cmd/temporaless-console/ui/node_modules ]; then
    (cd cmd/temporaless-console/ui && npm ci)
  fi
  (cd cmd/temporaless-console/ui && npm run check && npm test)
else
  echo "Skipping TypeScript client checks; npm is not on PATH (enter the Flox env)." >&2
fi
# Go is first-class and always part of the release gate. Generated protobuf
# packages under core/go/gen are Buf-owned and excluded from gofmt.
scripts/gofmt-check
go mod tidy -diff
go vet ./...
go run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.12.2 run ./...
go test -race ./...
if command -v cargo >/dev/null 2>&1; then
  cargo fmt --all --check
  cargo clippy --workspace --all-targets --locked -- -D warnings
  cargo test --workspace --locked
else
  echo "Skipping the Rust SDK checks; cargo is not on PATH (enter the Flox env)." >&2
fi
# Every Python uv project in scripts/python-projects: a locked sync, the ruff
# format check and lint over its listed paths, ty, and its tests. ty follows
# the ruff paths except in two projects: core/py leaves out its tests and the
# Buf-owned generated packages, and dagstercompat checks its generated-code
# fixtures against their own search paths.
# Prefect's temporary test server otherwise logs after pytest has closed its
# captured stream, printing a misleading traceback after a green suite; only
# the Prefect adapter reads these variables.
PREFECT_LOGGING_LEVEL=ERROR
PREFECT_LOGGING_TO_API_WHEN_MISSING_FLOW=ignore
export PREFECT_LOGGING_LEVEL PREFECT_LOGGING_TO_API_WHEN_MISSING_FLOW
while read -r project paths <&3; do
  case "$project" in '' | '#'*) continue ;; esac
  uv sync --project "$project" --locked
  # $paths is the space-separated path list from scripts/python-projects.
  uv run --project "$project" ruff format --check $paths
  uv run --project "$project" ruff check $paths
  case "$project" in
    core/py)
      uv run --project core/py ty check core/py/src/temporaless core/py/benchmarks examples/py scripts/check_buf_breaking.py scripts/check_versions.py scripts/set_version.py --exclude='**/temporaless/v1/**' --exclude='**/buf/**'
      ;;
    adapters/py/dagstercompat)
      uv run --project adapters/py/dagstercompat ty check adapters/py/dagstercompat/tests/test_process_boundary.py --extra-search-path adapters/py/dagstercompat/tests/gen
      uv run --project core/py ty check adapters/py/dagstercompat/tests/temporaless_server.py --extra-search-path adapters/py/dagstercompat/tests/server_gen
      ;;
    *)
      uv run --project "$project" ty check $paths
      ;;
  esac
  uv run --project "$project" pytest "$project/tests"
done 3<scripts/python-projects
