{
  "name": "@jim-technologies/temporaless",
  "version": "0.12.3",
  "private": true,
  "description": "TypeScript SDK for Temporaless protobuf, ConnectRPC, and Invariant Protocol projections.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/jim-technologies/temporaless#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jim-technologies/temporaless.git"
  },
  "bugs": {
    "url": "https://github.com/jim-technologies/temporaless/issues"
  },
  "type": "module",
  "main": "./core/ts/dist/index.js",
  "types": "./core/ts/dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./core/ts/dist/index.d.ts",
      "import": "./core/ts/dist/index.js"
    },
    "./gen/temporaless/v1": {
      "types": "./core/ts/dist/gen/temporaless/v1/temporaless_pb.d.ts",
      "import": "./core/ts/dist/gen/temporaless/v1/temporaless_pb.js"
    },
    "./gen/temporaless/v1/inspection": {
      "types": "./core/ts/dist/gen/temporaless/v1/inspection_pb.d.ts",
      "import": "./core/ts/dist/gen/temporaless/v1/inspection_pb.js"
    },
    "./invariant": {
      "types": "./core/ts/dist/invariant.d.ts",
      "import": "./core/ts/dist/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "core/ts/dist",
    "core/ts/README.md",
    "LICENSE",
    "README.md",
    "VERSION"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "build": "tsc -p core/ts/tsconfig.json && node core/ts/scripts/copy-assets.mjs",
    "test": "vitest run core/ts/test",
    "check": "npm run build && npm test",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.2.0",
    "@jim-technologies/invariant-protocol": "git+https://github.com/jim-technologies/invariantprotocol.git#79ead8726b4d79ee7c024b85441daf6f46851830"
  },
  "peerDependencies": {
    "@connectrpc/connect-node": ">=2.1.2",
    "@connectrpc/connect-web": ">=2.1.2"
  },
  "peerDependenciesMeta": {
    "@connectrpc/connect-node": {
      "optional": true
    },
    "@connectrpc/connect-web": {
      "optional": true
    }
  },
  "devDependencies": {
    "@connectrpc/connect-node": "^2.2.0",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "github:jim-technologies/invariantprotocol#79ead8726b4d79ee7c024b85441daf6f46851830": true,
    "protobufjs": false
  }
}
